{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcsd.info/schemas/provenance/v1/llm-invocation.schema.json",
  "title": "LLM invocation provenance v1",
  "description": "Safe, auditable execution metadata for a mutating LLM operation. Prompt contents, credentials, provider request IDs, and raw responses are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invocationId",
    "purpose",
    "provider",
    "model",
    "endpoint",
    "client",
    "parameters",
    "prompts",
    "outputContract",
    "inputs",
    "safety",
    "attempts",
    "effectiveAttempt",
    "outputHash",
    "cacheFingerprint"
  ],
  "properties": {
    "$schema": { "const": "https://rcsd.info/schemas/provenance/v1/llm-invocation.schema.json" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "invocationId": { "$ref": "common.schema.json#/$defs/id" },
    "purpose": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "$ref": "#/$defs/model" },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "revision"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sent", "providerDefaults", "unsupported"],
      "properties": {
        "sent": {
          "type": "object",
          "description": "The complete parameter object actually sent to the provider. Absent keys were not sent."
        },
        "providerDefaults": { "enum": ["documented", "unknown", "none"] },
        "unsupported": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemTemplateId", "systemTemplateHash", "userTemplateId", "userTemplateHash"],
      "properties": {
        "systemTemplateId": { "type": "string", "minLength": 1 },
        "systemTemplateHash": { "$ref": "common.schema.json#/$defs/hash" },
        "userTemplateId": { "type": ["string", "null"], "minLength": 1 },
        "userTemplateHash": { "$ref": "common.schema.json#/$defs/hash" },
        "renderedSystemHash": { "$ref": "common.schema.json#/$defs/hash" },
        "renderedUserHash": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "schemaHash", "toolSchemas"],
      "properties": {
        "schemaId": { "type": "string", "minLength": 1 },
        "schemaHash": { "$ref": "common.schema.json#/$defs/hash" },
        "toolSchemas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hash"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "hash": { "$ref": "common.schema.json#/$defs/hash" }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/lineageInput" }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLocale", "targetLocale", "glossaryHash"],
      "properties": {
        "sourceLocale": { "$ref": "common.schema.json#/$defs/locale" },
        "targetLocale": { "$ref": "common.schema.json#/$defs/locale" },
        "glossaryHash": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/hash" },
            { "type": "null" }
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "providerDefaults"],
      "properties": {
        "settings": { "type": "object" },
        "providerDefaults": { "enum": ["documented", "unknown", "none"] }
      }
    },
    "processing": {
      "type": "object",
      "description": "Versioned chunking, retry, repair, and validation choices that can affect output."
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "effectiveAttempt": { "type": "integer", "minimum": 1 },
    "outputHash": { "$ref": "common.schema.json#/$defs/hash" },
    "cacheFingerprint": { "$ref": "common.schema.json#/$defs/hash" }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "resolved"],
      "properties": {
        "requested": { "type": "string", "minLength": 1 },
        "resolved": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "startedAt", "completedAt", "model", "outcome", "validation", "finishReason"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "model": { "$ref": "#/$defs/model" },
        "outcome": { "enum": ["succeeded", "failed", "rejected"] },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "errors"],
          "properties": {
            "status": { "enum": ["passed", "failed", "not-run"] },
            "errors": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "finishReason": { "type": ["string", "null"] },
        "responseHash": { "$ref": "common.schema.json#/$defs/hash" },
        "promptHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "user"],
          "properties": {
            "system": { "$ref": "common.schema.json#/$defs/hash" },
            "user": { "$ref": "common.schema.json#/$defs/hash" },
            "additional": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/hash" }
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "estimatedCost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      }
    }
  }
}
