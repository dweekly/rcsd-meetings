{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcsd.info/schemas/provenance/v1/district-source-manifest.schema.json",
  "title": "District source manifest v1",
  "description": "District identity, language policy, source inventory, dated source regimes, safety defaults, and pilot targets. Reconnaissance observations are distinct from asserted platform cutovers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "status",
    "lastReviewedAt",
    "publication",
    "district",
    "languages",
    "governingBodies",
    "sources",
    "sourceRegimes",
    "accessibility",
    "privacy",
    "pilot",
    "openQuestions"
  ],
  "properties": {
    "$schema": { "const": "https://rcsd.info/schemas/provenance/v1/district-source-manifest.schema.json" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "manifestId": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "enum": ["reconnaissance", "pilot", "active", "retired"] },
    "lastReviewedAt": { "type": "string", "format": "date" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "classification"],
      "properties": {
        "automatic": { "type": "boolean" },
        "classification": {
          "enum": ["internal-reconnaissance-config", "public-config", "public-redacted-config"]
        }
      }
    },
    "district": { "$ref": "#/$defs/district" },
    "languages": { "$ref": "#/$defs/languages" },
    "governingBodies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/governingBody" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "sourceRegimes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRegime" }
    },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "pilot": { "$ref": "#/$defs/pilot" },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "district": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "publicName", "aliases", "jurisdiction", "identifiers", "districtType", "gradeSpan", "timezone", "officialWebsite"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "slug": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "publicName": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "jurisdiction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country", "state", "county"],
          "properties": {
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "county": { "type": "string", "minLength": 1 }
          }
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "minProperties": 1
        },
        "districtType": { "type": "string", "minLength": 1 },
        "gradeSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "sourceId"],
          "properties": {
            "low": { "type": "string", "minLength": 1 },
            "high": { "type": "string", "minLength": 1 },
            "sourceId": { "$ref": "common.schema.json#/$defs/id" },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "timezone": { "type": "string", "minLength": 1 },
        "officialWebsite": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageRule", "orderedPilotLocales", "evidenceSourceIds"],
      "properties": {
        "coverageRule": { "type": "string", "minLength": 1 },
        "orderedPilotLocales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "role", "status"],
            "properties": {
              "locale": { "$ref": "common.schema.json#/$defs/locale" },
              "role": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidenceSourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "governingBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "primary", "sourceIds"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "primary": { "type": "boolean" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "artifactTypes", "url", "authority", "vendor", "cadence", "archiveNotes", "checkedAt"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "domain": { "type": "string", "minLength": 1 },
        "artifactTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "authority": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "vendor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "product", "confidence", "basis"],
          "properties": {
            "name": { "type": ["string", "null"], "minLength": 1 },
            "product": { "type": ["string", "null"], "minLength": 1 },
            "confidence": { "enum": ["high", "medium", "low", "unknown"] },
            "basis": { "type": "string", "minLength": 1 }
          },
          "if": {
            "properties": { "confidence": { "not": { "const": "unknown" } } },
            "required": ["confidence"]
          },
          "then": {
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "product": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cadence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expectation"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "expectation": { "type": "string", "minLength": 1 }
          }
        },
        "archiveNotes": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date" }
      }
    },
    "sourceRegime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "sourceIds", "fromInclusive", "toExclusive", "precision", "observedFrom", "observedThrough", "boundaryConfidence", "notes"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "domain": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "fromInclusive": { "type": ["string", "null"] },
        "toExclusive": { "type": ["string", "null"] },
        "precision": { "enum": ["day", "month", "school-year", "unknown"] },
        "observedFrom": { "type": ["string", "null"] },
        "observedThrough": { "type": ["string", "null"] },
        "boundaryConfidence": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyStatus", "auditHtmlSemantics", "auditPdfTextAndReadingOrder", "auditVideoCaptions", "provideLowBandwidthTextAlternative", "neverTreatVendorAccessibilityClaimsAsArtifactVerification"],
      "properties": {
        "policyStatus": { "type": "string", "minLength": 1 },
        "auditHtmlSemantics": { "type": "boolean" },
        "auditPdfTextAndReadingOrder": { "type": "boolean" },
        "auditVideoCaptions": { "type": "boolean" },
        "provideLowBandwidthTextAlternative": { "type": "boolean" },
        "neverTreatVendorAccessibilityClaimsAsArtifactVerification": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyStatus", "sourceBeingPublicIsNotSufficientForRepublication", "reviewPersonalNamesBeforeIndexing", "suppressProtectedSmallCells", "doNotPublishStudentRecordsOrMeetingCredentials", "classifyEveryMirroredArtifactBeforeRelease"],
      "properties": {
        "policyStatus": { "type": "string", "minLength": 1 },
        "sourceBeingPublicIsNotSufficientForRepublication": { "type": "boolean" },
        "reviewPersonalNamesBeforeIndexing": { "type": "boolean" },
        "suppressProtectedSmallCells": { "type": "boolean" },
        "doNotPublishStudentRecordsOrMeetingCredentials": { "type": "boolean" },
        "classifyEveryMirroredArtifactBeforeRelease": { "type": "boolean" }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sampleTargets", "successSignals"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "validationTemplate": { "$ref": "common.schema.json#/$defs/relativePath" },
        "sampleTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "selection"],
            "properties": {
              "domain": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 },
              "minimum": { "type": "integer", "minimum": 1 },
              "maximum": { "type": "integer", "minimum": 1 },
              "unit": { "type": "string", "minLength": 1 },
              "selection": { "type": "string", "minLength": 1 }
            },
            "anyOf": [
              { "required": ["count"] },
              { "required": ["minimum", "maximum"] }
            ]
          }
        },
        "successSignals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
