{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcsd.info/schemas/provenance/v1/common.schema.json",
  "title": "RCSD provenance common definitions v1",
  "$defs": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "publicPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)/?.+$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:|/(?:[^~]|~[01])*)$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "hash"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "mediaType": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "lineageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": {
        "datasetId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "artifactPath": { "$ref": "#/$defs/relativePath" },
        "pointer": { "$ref": "#/$defs/jsonPointer" },
        "hash": { "$ref": "#/$defs/hash" }
      },
      "anyOf": [
        { "required": ["datasetId"] },
        { "required": ["sourceId"] },
        { "required": ["artifactPath"] }
      ]
    },
    "qualityException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "artifactPath": { "$ref": "#/$defs/relativePath" },
        "pointer": { "$ref": "#/$defs/jsonPointer" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["unreviewed", "machine-checked", "human-reviewed", "reconciled", "partial"]
        },
        "checkedAt": { "type": "string", "format": "date-time" },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualityException" }
        }
      },
      "if": {
        "properties": { "state": { "const": "partial" } },
        "required": ["state"]
      },
      "then": {
        "required": ["exceptions"],
        "properties": { "exceptions": { "type": "array", "minItems": 1 } }
      }
    }
  }
}
