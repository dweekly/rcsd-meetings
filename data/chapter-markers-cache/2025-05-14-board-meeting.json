        "publicComments": [
          {
            "name": "Amica Guillaume",
            "startSeconds": 180,
            "endSeconds": 358,
            "summary": "As COO of Peninsula Bridge, she updated the board on the program's expansion to a 13-year model, highlighting that 20 Redwood City students were selected from 87 nominated, and sharing outcomes including near-zero college debt and 92% full employment for program graduates."
          },
          {
            "name": "Maya Rosales Rosiles",
            "startSeconds": 384,
            "endSeconds": 406,
            "summary": "Expressed gratitude to the board for allowing Advanced English classes at Kennedy Middle School."
          },
          {
            "name": "Saoirse Rafferty",
            "startSeconds": 406,
            "endSeconds": 440,
            "summary": "On behalf of the Orion Mandarin Immersion class of 2025, deeply thanked the board for implementing advanced ELA classes at Kennedy, saying it will help students fulfill their dreams."
          },
          {
            "name": "Nia",
            "startSeconds": 455,
            "endSeconds": 470,
            "summary": "Thanked the board for the advanced ELA program and expressed excitement about learning more advanced vocabulary to help achieve her dreams."
          },
          {
            "name": "Finbar",
            "startSeconds": 492,
            "endSeconds": 497,
            "summary": "Briefly thanked the board for the advanced ELA program."
          },
          {
            "name": "Megan",
            "startSeconds": 512,
            "endSeconds": 554,
            "summary": "Seconded the students' comments, thanked the board for carefully considering the advanced ELA issue, and brought small gifts of salad dressing to show appreciation for the board's effort."
          }
        ],
        "consent": false,
        "pulled": false
