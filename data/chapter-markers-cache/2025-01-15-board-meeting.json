        "itemLabel": "7",
        "title": "Public Hearing regarding the Connect Community Charter School Renewal Petition",
        "phases": {
          "opened": 5322,
          "presentation": 5539,
          "publicComment": 6550,
          "discussion": null,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Julio Segite",
            "startSeconds": 6574,
            "endSeconds": 6776,
            "summary": "Expressed deep gratitude to the board and shared that his child's success at Connect and later university enrollment demonstrates the school's positive impact on the Latino community."
          },
          {
            "name": "Amanda Vaughn",
            "startSeconds": 6987,
            "endSeconds": 7135,
            "summary": "Spoke as a 16-year veteran teacher in her third year at Connect, highlighting the newcomer program and art program and praising the school's comprehensive support for English learners."
          },
          {
            "name": "Maida Okelon",
            "startSeconds": 7170,
            "endSeconds": 7235,
            "summary": "Described her experience as a long-term substitute teacher at Connect and praised the school's SEL and project-based learning focus, urging the district to renew the charter."
          },
          {
            "name": "Monique Pusalis",
            "startSeconds": 7345,
            "endSeconds": 7507,
            "summary": "Spoke as the music teacher at Connect, describing the school's inaugural student musical production 'Space is the Place' as an exemplary project-based learning achievement involving nearly all students."
          },
          {
            "name": "Walter Soto Franco",
            "startSeconds": 7547,
            "endSeconds": 7651,
            "summary": "As a recent Connect graduate originally from Guatemala, shared how the school helped him learn English and develop as a person, expressing hope that his future children will attend Connect."
          },
          {
            "name": "Ixamar Giron",
            "startSeconds": 7678,
            "endSeconds": 7811,
            "summary": "As a Connect alumna now studying mechanical engineering at San Francisco State University, credited Connect with shaping her academically and personally, and noted her siblings continue to thrive there."
          },
          {
            "name": "Ashley Solis",
            "startSeconds": 7860,
            "endSeconds": 7889,
            "summary": "As a current eighth grader who has attended Connect since third grade, thanked the school for helping her learn to speak and read English and for the caring treatment by staff."
          }
        ],
        "consent": false,
        "pulled": false
      },
