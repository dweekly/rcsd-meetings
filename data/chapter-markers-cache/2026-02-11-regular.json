        "publicComments": [
          {
            "name": "Brianna Gear",
            "startSeconds": 165,
            "endSeconds": 234,
            "summary": "Spoke as MIT staff to urge the board to retain Nelson Brazil, describing him as foundational to PBIS, student advocacy, and school safety at McKinley Institute of Technology."
          },
          {
            "name": "Carolina Rodriguez",
            "startSeconds": 245,
            "endSeconds": 433,
            "summary": "MIT science teacher shared two student stories (Lupe and Ricky) illustrating how Nelson Brazil's deep family relationships and social-emotional coaching directly improved attendance, behavior, and academic outcomes."
          },
          {
            "name": "Molly Cross",
            "startSeconds": 448,
            "endSeconds": 537,
            "summary": "Read a letter from MIT teacher Henri Kuhn calling Nelson Brazil's work essential to school culture and urging the board to reverse the decision to eliminate the student services coordinator position."
          }
        ],
        "consent": false,
        "pulled": false
      },
      {
        "itemLabel": "9",
        "title": "Labor Association Comments",
        "phases": {
          "opened": 551,
          "presentation": null,
          "publicComment": 551,
          "discussion": null,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Amy Barstad",
            "startSeconds": 564,
            "endSeconds": 719,
            "summary": "RCTA negotiations chair opened bargaining season by stating the union's priorities of manageable class sizes and competitive compensation, and pledged good-faith, data-informed negotiations."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 720,
            "endSeconds": 855,
            "summary": "CSEA President congratulated Trustee Li on his new child, invited board members to meet with CSEA, presented Li with a missed raffle prize, and reminded principals of the CSEA $100 scholarship for 8th graders."
          }
        ],
        "consent": false,
        "pulled": false
      },
