      {
        "itemLabel": "11",
        "title": "Review of Draft Resolution: Calling An Election, Establishing Specifications Of The Election Order, And Requesting Consolidation With Other Elections Occurring On June 2, 2026",
        "phases": {
          "opened": 2589,
          "presentation": 2613,
          "publicComment": 4347,
          "discussion": 3633,
          "vote": null
        },
        "publicComments": [
          {
            "name": "David Camarena",
            "startSeconds": 4364,
            "endSeconds": 4452,
            "summary": "Taft principal expressed strong support for the parcel tax, describing how it would fund STEAM, counselors, professional development, guest teacher coverage, and help retain key staff."
          },
          {
            "name": "Carl Landers",
            "startSeconds": 4464,
            "endSeconds": 4589,
            "summary": "Community member supported the parcel tax framework but urged the board to publicly articulate how the district's half of funds would be spent (especially teacher salaries) and questioned whether the rate could be set higher than 17.5 cents."
          },
          {
            "name": "Winnie Chiu",
            "startSeconds": 4602,
            "endSeconds": 4713,
            "summary": "Orion principal advocated for the parcel tax, citing the loss of part-time reading intervention and TOSA positions, the need to sustain the Mandarin immersion instructional coach, and limited guest teacher support for IEPs."
          },
          {
            "name": "Lupe Guzman",
            "startSeconds": 4734,
            "endSeconds": 4909,
            "summary": "Hoover Community School principal urged passage of the parcel tax to protect staffing for high-need students, maintain reading and math intervention, support English learners, and fund mental health and enrichment programs."
          }
        ],
        "consent": false,
        "pulled": false
      },
