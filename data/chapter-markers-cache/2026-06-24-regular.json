      {
        "itemLabel": "10",
        "title": "Reception — Recognition of Superintendent Baker",
        "phases": {
          "opened": 221,
          "presentation": null,
          "publicComment": 221,
          "discussion": null,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Dennis McBride",
            "startSeconds": 257,
            "endSeconds": 446,
            "summary": "Former board member praised Dr. Baker's 40-plus years of service, his balance between superintendent and board roles, compassionate leadership, and the overwhelmingly positive community reaction when he was named superintendent."
          },
          {
            "name": "David Bovito",
            "startSeconds": 469,
            "endSeconds": 592,
            "summary": "Representative of Assemblymember Pappin congratulated Dr. Baker on over 40 years dedicated to one district and praised his wisdom shared at community workforce and education forums."
          },
          {
            "name": "Gabriella Morales",
            "startSeconds": 595,
            "endSeconds": 648,
            "summary": "On behalf of Senator Josh Becker and Assemblymembers Berman and Pappin, presented Dr. Baker with a legislative resolution honoring his service and deep community involvement."
          },
          {
            "name": "Alyssa MacAvoy",
            "startSeconds": 706,
            "endSeconds": 870,
            "summary": "Former 17-year board member praised Dr. Baker's unwavering commitment to students and equity, his people-centered leadership, and wished him a joyful retirement while expressing confidence the district's strong foundation will continue."
          },
          {
            "name": "Wendy Kelly",
            "startSeconds": 882,
            "endSeconds": 1074,
            "summary": "Deputy Superintendent honored Dr. Baker's 46 years of service, highlighting his heart-centered leadership, transparent communication, mentorship of educators, and his role as an anchor through turbulent times."
          },
          {
            "name": "Rick Edson",
            "startSeconds": 1084,
            "endSeconds": 1129,
            "summary": "Chief Business Official thanked Dr. Baker for four years of trust, support, and unwavering focus on student success even when decisions were difficult."
          }
        ],
        "consent": false,
        "pulled": false
      },
