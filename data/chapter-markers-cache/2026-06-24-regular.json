        "itemLabel": "10",
        "title": "Reception — Recognition of Superintendent Baker",
        "phases": {
          "opened": 218,
          "presentation": null,
          "publicComment": 218,
          "discussion": null,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Dennis McBride",
            "startSeconds": 257,
            "endSeconds": 446,
            "summary": "Former board member recalled his 30+ year relationship with Dr. Baker, praised his mastery of the superintendent-board balance, and recalled the unanimous standing ovation from staff when Baker was named superintendent."
          },
          {
            "name": "David Bovito",
            "startSeconds": 472,
            "endSeconds": 592,
            "summary": "Representative for Assemblymember Dion Pappen praised Dr. Baker's 40-plus years of service to one community and thanked him for his wisdom shared at county workforce and education forums."
          },
          {
            "name": "Gabriella Morales",
            "startSeconds": 595,
            "endSeconds": 648,
            "summary": "On behalf of Senator Josh Becker and Assemblymembers Berman and Pappin, presented a legislative resolution honoring Dr. Baker's extraordinary contributions to the community and county."
          },
          {
            "name": "Alyssa McEvoy",
            "startSeconds": 706,
            "endSeconds": 870,
            "summary": "Former 17-year board member expressed deep gratitude for Dr. Baker's unwavering commitment to students and equity, and celebrated the strong foundation he built for the district."
          },
          {
            "name": "Wendy Kelly",
            "startSeconds": 882,
            "endSeconds": 1074,
            "summary": "Deputy Superintendent of 14 years praised Dr. Baker's heart-centered leadership, his communication during crises, and his ability to make every employee feel valued and heard."
          },
          {
            "name": "Rick Edson",
            "startSeconds": 1084,
            "endSeconds": 1129,
            "summary": "Chief Business Official thanked Dr. Baker for four years of trust, support, and student-focused decision-making."
          }
        ],
        "consent": false,
