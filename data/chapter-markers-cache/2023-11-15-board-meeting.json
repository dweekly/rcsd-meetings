      {
        "itemLabel": "3",
        "title": "Study Session: Discussion on Dyslexia",
        "phases": {
          "opened": 93,
          "presentation": 102,
          "publicComment": 1745,
          "discussion": 3021,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Urs Neber",
            "startSeconds": 1778,
            "endSeconds": 1986,
            "summary": "Shared his son Leo's experience being diagnosed with dyslexia after struggling in first grade, described the high cost of private evaluation and tutoring, and urged the district to ensure reading instruction is accessible to all students regardless of financial means."
          },
          {
            "name": "Deanne Dell'Antoni",
            "startSeconds": 2004,
            "endSeconds": 2018,
            "summary": "Speaker card was submitted but speaker did not come to the podium and did not speak."
          },
          {
            "name": "Giselle Hale",
            "startSeconds": 2023,
            "endSeconds": 2222,
            "summary": "As a parent of two dyslexic students and community advocate, urged the board to treat dyslexia as a general education issue, highlighted districts making gains by training all teachers in structured literacy, and emphasized that implementation rigor matters more than curriculum selection alone."
          },
          {
            "name": "Fallon Scoggins",
            "startSeconds": 2240,
            "endSeconds": 2588,
            "summary": "Described her son Ender's severe dyslexia and dysgraphia, the inadequacy of in-school pullouts and after-school tutoring, his need for a specialized school, and urged the board to rethink how dyslexia is framed and to make structured literacy instruction available throughout the school day for all students."
          },
          {
            "name": "Jennifer Salma",
            "startSeconds": 2607,
            "endSeconds": 3020,
            "summary": "As a regional leader with Decoding Dyslexia California, praised the district's use of the California Dyslexia Guidelines and universal screening legislation, highlighted the strengths of dyslexic thinkers, and stressed the importance of implementing programs with fidelity and ensuring principal and administrative buy-in."
          }
        ],
        "consent": false,
        "pulled": false
      },
