        "itemLabel": "3",
        "title": "Study Session: Discussion on Dyslexia",
        "phases": {
          "opened": 92,
          "presentation": 103,
          "publicComment": 1764,
          "discussion": 3022,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Ors Neighbor",
            "startSeconds": 1778,
            "endSeconds": 1987,
            "summary": "Shared his son Leor's experience with dyslexia diagnosis, the high cost of private evaluation and tutoring, and advocated for the community to find ways to teach reading to all children regardless of financial resources."
          },
          {
            "name": "Giselle Hale",
            "startSeconds": 2022,
            "endSeconds": 2221,
            "summary": "As a parent of two dyslexic students and wife of a dyslexic, she urged the board to treat dyslexia as a general education issue and highlighted districts making strides by training all teachers in Orton-Gillingham techniques and focusing on rigorous implementation."
          },
          {
            "name": "Fallon Scoggins",
            "startSeconds": 2229,
            "endSeconds": 2590,
            "summary": "Shared her son Ender's severe dyslexia journey, emphasizing the inaccessibility of structured literacy support without financial means and urging the board to make structured literacy instruction available to all students throughout the school day."
          },
          {
            "name": "Jennifer Salma",
            "startSeconds": 2607,
            "endSeconds": 3022,
            "summary": "As a regional leader with Decoding Dyslexia California, she thanked the board for engaging with the California Dyslexia Guidelines, emphasized implementing programs with fidelity, and encouraged building systems so dyslexic students receive in-school support rather than relying on after-school tutoring."
          }
        ],
        "consent": false,
