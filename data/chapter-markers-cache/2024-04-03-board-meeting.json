          {
            "name": "Ariana Balte",
            "startSeconds": 196,
            "endSeconds": 458,
            "summary": "A 20-year North Star Academy teacher urged the board to move North Star to the former Adelante campus at 3150 Granger Street, citing overcrowding, shared-campus conflicts with MIT students, scheduling problems due to insufficient enrollment, and the need for a dedicated campus environment."
          },
          {
            "name": "Edison Chang",
            "startSeconds": 464,
            "endSeconds": 1098,
            "summary": "A parent spoke in Spanish (with English interpretation) about his 13-year-old daughter in special education at Kennedy School, requesting the district conduct autism and dyslexia evaluations that had twice been denied, noting her declining grades, frequent absences, and refusal to attend school."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 1176,
            "endSeconds": 1388,
            "summary": "A long-time RCSD classified employee and CSEA member urged board members to visit school sites and engage directly with all staff — including classified employees — as past board members had done, and highlighted the importance of libraries and librarians in the district."
          }
        ],
