      {
        "itemLabel": "9.1",
        "title": "Discussion on COVID-19",
        "phases": {
          "opened": 3705,
          "presentation": 3713,
          "publicComment": 8447,
          "discussion": 5505,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Katherine Stewart",
            "startSeconds": 8476,
            "endSeconds": 8535,
            "summary": "A parent expressed concern about in-person childcare pods spreading COVID and urgently requested that school schedules be sent to parents as soon as possible, even if not finalized."
          },
          {
            "name": "Ali Gilmore",
            "startSeconds": 8567,
            "endSeconds": 8597,
            "summary": "A parent thanked the district for its efforts on childcare support, emphasizing it is critical for working parents who need it."
          },
          {
            "name": "Becky Fouch",
            "startSeconds": 8619,
            "endSeconds": 8741,
            "summary": "A parent asked the board to clarify whether Zoom would be allowed in addition to Google Meet given Google's delays, and raised concern that teachers had not received necessary technology equipment despite CARES Act funding being available."
          },
          {
            "name": "Michelle Smith",
            "startSeconds": 8924,
            "endSeconds": 9079,
            "summary": "A parent praised the district's work, raised concerns about the very short synchronous session lengths for younger grades based on summer school experience, thanked the district for childcare coordination, and supported allowing Zoom with breakout rooms."
          }
        ],
        "consent": false,
        "pulled": false
      },
