        "publicComments": [
          {
            "name": "Marianne",
            "startSeconds": 9357,
            "endSeconds": 9503,
            "summary": "Advocated for preserving in-house district mental health counseling positions, emphasizing that the people in those roles have built irreplaceable relationships with students and that the community survey identified mental health counseling as a top priority."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 9520,
            "endSeconds": 9717,
            "summary": "As CSEA representative, criticized the timing and process of the cuts, expressing concern that employees were being told their positions were eliminated rather than reduced, and that board members had not visited sites to understand what classified employees do."
          },
          {
            "name": "Jessica Shade",
            "startSeconds": 9832,
            "endSeconds": 9920,
            "summary": "Announced a citizen-led effort to place a parcel tax on the ballot to counteract the budget cuts, asking for volunteers and directing listeners to StrongSchools4RWC.org."
