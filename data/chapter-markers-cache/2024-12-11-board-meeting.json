        "itemLabel": "9.1",
        "title": "Approval of Budget Renewal Initiative, Superintendent Recommendations",
        "phases": {
          "opened": 6748,
          "presentation": 6753,
          "publicComment": 9317,
          "discussion": 9939,
          "vote": {
            "seconds": 11577,
            "type": "voice",
