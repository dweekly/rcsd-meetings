          }
        },
        "publicComments": [
          {
            "name": "Marianne",
            "startSeconds": 9358,
            "endSeconds": 9506,
            "summary": "Advocated for preserving the in-house district mental health counseling team, noting that 4.5 FTE positions are proposed for cuts despite the community survey identifying mental health counseling as the top priority, and emphasizing the irreplaceable value of the relationships counselors have built with students."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 9520,
            "endSeconds": 9718,
            "summary": "As CSEA representative, criticized the timing and process of the proposed cuts, arguing that positions were being eliminated rather than reduced hours offered, that many of these positions were not discussed with CSEA in advance, and that the district's approach of cutting before Christmas was unnecessarily harsh."
          },
          {
            "name": "Jessica Shade",
            "startSeconds": 9835,
            "endSeconds": 9921,
            "summary": "Announced that a group of parents is organizing a citizens initiative to put a parcel tax on the ballot to counteract the budget cuts, and shared the website strongschools4rwc.org for community members to get involved."
          }
        ],
        "consent": false,
        "pulled": false
      },
