          "vote": null
        },
        "publicComments": [
          {
            "name": "Marisol Mendoza",
            "startSeconds": 7963,
            "endSeconds": 8077,
            "summary": "Expressed disappointment that the district rejected CSEA's request for extra compensation for classified employees working on-site during COVID, arguing that classified staff workloads and risks have increased comparably to teachers who received additional pay."
          },
          {
            "name": "Michael Hofer",
            "startSeconds": 8135,
            "endSeconds": 8545,
            "summary": "Asked what the district's Plan B is if the vaccination-dependent reopening plan does not materialize, and when parents will know whether their children will return to in-person learning in April or August."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 8576,
            "endSeconds": 8769,
            "summary": "Challenged the board to visit school sites to witness the increased workload of classified staff and requested that classified employees be given an opportunity to present at a board meeting about how their jobs and mental health have been affected during the pandemic."
          }
        ],
        "consent": false,
