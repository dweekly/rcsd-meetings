      {
        "itemLabel": "7.5",
        "title": "Approval of Permanently Renaming the 170 Selby Lane in Atherton site as Adelante Selby Spanish Immersion School",
        "phases": {
          "opened": 9043,
          "presentation": 9054,
          "publicComment": 9187,
          "discussion": 9900,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Suzanne Ruiz Dunlap",
            "startSeconds": 9242,
            "endSeconds": 9304,
            "summary": "Thanked the naming committee and Dr. Baker for honoring the community's voice and urged the board to vote to permanently name the school Adelante Selby Spanish Immersion School."
          },
          {
            "name": "Michelle Smith",
            "startSeconds": 9316,
            "endSeconds": 9522,
            "summary": "Expressed frustration with the naming process, calling it undemocratic and arguing that the community's voice was not adequately considered the first time, and that the drawn-out process further eroded trust between the community and the board."
          },
          {
            "name": "Jonathan Cantu",
            "startSeconds": 9571,
            "endSeconds": 9688,
            "summary": "Expressed disappointment that the board initially declined the naming recommendation and voiced concern that the Adelante community was at risk of losing both their campus and their school name."
          },
          {
            "name": "Chris Rosane",
            "startSeconds": 9703,
            "endSeconds": 9754,
            "summary": "Affirmed that the community felt the process was controlled by the loudest voices at the end and reiterated strong community attachment to the Adelante Selby identity."
          },
          {
            "name": "Devin Mulaney",
            "startSeconds": 9809,
            "endSeconds": 9888,
            "summary": "Expressed appreciation for the process but urged the board to wrap up the naming decision quickly given other pressing district priorities, and noted a potential name-confusion issue with a nearby continuation school named Mid-Peninsula."
          }
        ],
        "consent": false,
        "pulled": false
      },
