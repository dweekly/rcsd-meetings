        "publicComments": [
          {
            "name": "Noah Gasper",
            "startSeconds": 189,
            "endSeconds": 243,
            "summary": "Expressed concern that TK students at Orion will have no on-campus aftercare options due to space limitations for Play Thrive and age restrictions for Catalyst, and asked the board to help find solutions."
          },
          {
            "name": "Haiqing Yang",
            "startSeconds": 268,
            "endSeconds": 367,
            "summary": "Urged the board to open additional classrooms and extend aftercare services to children 4 years and older, arguing that without reliable on-campus aftercare, universal TK is inaccessible to working families."
          },
          {
            "name": "Michelle Strobie",
            "startSeconds": 554,
            "endSeconds": 619,
            "summary": "Thanked the board and Dr. Baker for their efforts on the aftercare issue and offered parent support in finding solutions for TK and kindergarten families at Orion."
          }
        ],
        "consent": false,
        "pulled": false
      },
      {
        "itemLabel": "9",
        "title": "Discussion of Citizens' Initiative and District-Sponsored Parcel Tax",
        "phases": {
          "opened": 620,
          "presentation": 671,
          "publicComment": 1805,
          "discussion": 2229,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Carlo Contavalli",
            "startSeconds": 1819,
            "endSeconds": 1957,
            "summary": "Spoke as a proponent of the citizens' initiative parcel tax, emphasizing the urgency of finding new funding given budget cuts and arguing that a square-footage-based measure would be equitable and has proven successful in the Bay Area."
          },
          {
            "name": "Jessica Shade",
            "startSeconds": 1981,
            "endSeconds": 2103,
            "summary": "Explained that the citizens' initiative group is separate from the district but supportive of either path to a parcel tax, and encouraged incoming TK/K parents to get involved."
          },
          {
            "name": "Adina Olson",
            "startSeconds": 2129,
            "endSeconds": 2216,
            "summary": "Echoed support for obtaining additional school funding through either a citizens' initiative or district-sponsored parcel tax, noting the impact of budget cuts on her school community."
          }
        ],
        "consent": false,
        "pulled": false
