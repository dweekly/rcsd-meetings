        "publicComments": [
          {
            "name": "Noah Gasper",
            "startSeconds": 190,
            "endSeconds": 244,
            "summary": "Expressed concern about the lack of on-campus aftercare options for incoming TK students at Orion Alternative, noting that neither Playthrive nor Catalyst could serve his daughter's age group."
          },
          {
            "name": "Hai Ching Young",
            "startSeconds": 267,
            "endSeconds": 365,
            "summary": "Urged the board to open additional classrooms and extend aftercare services to children 4 years and older, arguing that Universal TK is inaccessible to working families without reliable on-campus aftercare."
          },
          {
            "name": "Michelle Strobi",
            "startSeconds": 552,
            "endSeconds": 619,
            "summary": "Thanked the board and Dr. Baker for their efforts on the aftercare issue, expressed understanding of the difficulties facing public education, and offered parent support to help find solutions."
          }
        ],
        "consent": false,
        "pulled": false
      },
      {
        "itemLabel": "9",
        "title": "Discussion of Citizens' Initiative and District-Sponsored Parcel Tax",
        "phases": {
          "opened": 620,
          "presentation": 671,
          "publicComment": 1806,
          "discussion": 2217,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Carlo Pontavalli",
            "startSeconds": 1828,
            "endSeconds": 1958,
            "summary": "Expressed urgency for additional school funding via a parcel tax, citing budget cuts, teacher shortages, and the success of square-footage-based initiatives in the Bay Area."
          },
          {
            "name": "Jessica Shade",
            "startSeconds": 1984,
            "endSeconds": 2103,
            "summary": "Stated that the citizens' initiative group supports any path to a parcel tax—district-sponsored or citizen-led—and encouraged incoming TK/K parents to get involved."
          },
          {
            "name": "Adina Olson",
            "startSeconds": 2130,
            "endSeconds": 2216,
            "summary": "Echoed support for securing additional school funding through either a citizens' initiative or district-sponsored parcel tax, noting the impact of budget cuts on her children's school."
          }
        ],
        "consent": false,
        "pulled": false
      },
