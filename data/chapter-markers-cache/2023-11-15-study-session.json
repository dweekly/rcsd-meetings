      {
        "itemLabel": "3",
        "title": "Study Session: Discussion on Dyslexia",
        "phases": {
          "opened": 93,
          "presentation": 102,
          "publicComment": 1768,
          "discussion": 3021,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Urs Neber",
            "startSeconds": 1778,
            "endSeconds": 1986,
            "summary": "Shared his son Leo's experience being diagnosed with dyslexia, the difficulty and expense of obtaining an independent evaluation, and the frustration of the school not qualifying him for services despite strong evidence, urging the community to find ways to teach reading to all children regardless of resources."
          },
          {
            "name": "Giselle Hale",
            "startSeconds": 2019,
            "endSeconds": 2222,
            "summary": "Encouraged the board to treat dyslexia as a general education issue, cited districts making the most progress by training all teachers in Orton-Gillingham techniques, and emphasized that implementation fidelity and rigorous teacher support are critical to seeing gains."
          },
          {
            "name": "Fallon Scoggins",
            "startSeconds": 2240,
            "endSeconds": 2588,
            "summary": "Shared her son Ender's experience with severe dyslexia and dysgraphia, described the inadequacy of pullout interventions and after-school tutoring, and urged the board to make structured literacy available throughout the school day for all students, especially given the link between illiteracy and incarceration."
          },
          {
            "name": "Jennifer Salma",
            "startSeconds": 2607,
            "endSeconds": 3020,
            "summary": "As a regional leader with Decoding Dyslexia California, she thanked the board for engaging with the California Dyslexia Guidelines, emphasized that dyslexia comes with strengths not just challenges, stressed the importance of program fidelity and principal support, and urged early intervention so children can thrive in general education environments."
          }
        ],
        "consent": false,
        "pulled": false
      },
