        "itemLabel": "3",
        "title": "Study Session: Discussion on Dyslexia",
        "phases": {
          "opened": 92,
          "presentation": 103,
          "publicComment": 1764,
          "discussion": 3022,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Ors Neighbor",
            "startSeconds": 1778,
            "endSeconds": 1987,
            "summary": "Shared his son Leor's experience with dyslexia diagnosis and the financial and emotional burden of obtaining private evaluations and tutoring, urging the district to make reading support accessible regardless of family resources."
          },
          {
            "name": "Giselle Hale",
            "startSeconds": 2022,
            "endSeconds": 2221,
            "summary": "As a parent of two dyslexic district students and a community advocate, she urged the board to treat dyslexia as a general education issue and highlighted districts making strides through Orton-Gillingham training for all teachers."
          },
          {
            "name": "Fallon Scoggins",
            "startSeconds": 2229,
            "endSeconds": 2590,
            "summary": "Described her son Ender's severe dyslexia and dysgraphia journey, the inadequacy of pull-out-only interventions, and urged the board to make structured literacy available throughout the school day and to rethink how dyslexia is framed."
          },
          {
            "name": "Jennifer Salma",
            "startSeconds": 2607,
            "endSeconds": 3022,
            "summary": "Speaking as a regional leader with Decoding Dyslexia California, she thanked the district for engaging with the California Dyslexia Guidelines and urged fidelity in program implementation and strong principal support for teachers."
          }
        ],
        "consent": false,
        "pulled": false
