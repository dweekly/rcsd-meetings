          {
            "name": "Pam Barash",
            "startSeconds": 336,
            "endSeconds": 478,
            "summary": "A kindergarten teacher at Henry Ford School urged the board to compensate teachers appropriately given rising cost of living so the district can attract and retain quality educators."
          },
          {
            "name": "Bree Hennie",
            "startSeconds": 496,
            "endSeconds": 668,
            "summary": "A Clifford parent demanded full transparency about the district's knowledge when hiring a teacher with a history of inappropriate behavior and asked what safeguards are in place to protect students."
          },
          {
            "name": "Sarah Heftersbach",
            "startSeconds": 684,
            "endSeconds": 817,
            "summary": "A Clifford parent expressed concern about the hiring of an accused sexual harasser and requested a retroactive review of all teachers hired across the district for relevant prior investigations."
          },
          {
            "name": "Josh Levinson",
            "startSeconds": 823,
            "endSeconds": 923,
            "summary": "A Clifford parent stated he filed a formal Title IX complaint after learning from his son that a teacher's problematic behavior had continued, and called for transparency and long-term change."
          },
          {
            "name": "Jonathan Cantu",
            "startSeconds": 982,
            "endSeconds": 1001,
            "summary": "An online commenter asked whether the board finds it acceptable to employ a teacher fired for inappropriately touching students and what the board intends to do about it."
          }
