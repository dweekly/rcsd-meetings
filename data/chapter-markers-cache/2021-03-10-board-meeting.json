        "itemLabel": "12",
        "title": "COVID-19 and Reopening Update",
        "phases": {
          "opened": 2492,
          "presentation": 2541,
          "publicComment": 5725,
          "discussion": 6748,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Pam Barash",
            "startSeconds": 5757,
            "endSeconds": 5925,
            "summary": "Asked whether students and families who travel during spring break will be required to quarantine before returning, expressing concern that travel-related quarantines could disrupt the planned in-person return in April."
          },
          {
            "name": "Indra Hernandez",
            "startSeconds": 5977,
            "endSeconds": 6178,
            "summary": "Raised concerns about inconsistent COVID protocols among staff, asked about wellness surveys, inquired whether preschool children would be tested before returning, and asked about scheduling back-to-school meetings that may violate social distancing guidelines."
          },
          {
            "name": "Stephanie Chen",
            "startSeconds": 6248,
            "endSeconds": 6409,
            "summary": "Asked whether there could be more uniformity across schools in the plans for returning to in-person learning, citing equity concerns."
          },
          {
            "name": "Shawna Hackworth",
            "startSeconds": 6592,
            "endSeconds": 6656,
            "summary": "Asked whether students with school-of-choice placements who opt into the virtual academy for 2021-22 would lose their school-of-choice spot for 2022-23, and whether that answer would be clear before the survey deadline."
          }
        ],
        "consent": false,
        "pulled": false
      },
