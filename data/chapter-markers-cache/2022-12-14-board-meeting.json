        "itemLabel": "5",
        "title": "Recognition of María Díaz-Slocum",
        "phases": {
          "opened": 794,
          "presentation": 794,
          "publicComment": null,
          "discussion": null,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Dennis McBride",
            "startSeconds": 1852,
            "endSeconds": 2033,
            "summary": "Paid tribute to María Díaz-Slocum's 21 years of service, highlighting her dedication to students, her calm leadership, and her role as the face of the school board on the Bayside."
          },
          {
            "name": "Ninfa and Secundino (Familia Unidas representatives)",
            "startSeconds": 2042,
            "endSeconds": 2170,
            "summary": "On behalf of Familia Unidas parents and students, thanked María for her incredible support in helping hundreds of families achieve success through literacy and learning."
          },
          {
            "name": "Giselle Hill",
            "startSeconds": 2170,
            "endSeconds": 2264,
            "summary": "As a freshly retired city official, praised María as a giant in Redwood City whose work on equity predated broad discussions of equity, and welcomed new trustee David Weekley and congratulated Cecilia Márquez."
          },
          {
            "name": "Michelle Torres",
            "startSeconds": 2422,
            "endSeconds": 2523,
            "summary": "Thanked María and Familia Unidas for unconditional support, sharing how the program helped her feel at home, supported her family's educational goals, and led to her son's improved academic performance."
          },
          {
            "name": "Beatriz Fernanda Senda",
            "startSeconds": 2600,
            "endSeconds": 2724,
            "summary": "An 11-year-old Familia Unidas member since preschool shared how the program taught her about reading, math, technology, health, and science, and expressed hope that the program continues."
          },
          {
            "name": "Laura Ramirez",
            "startSeconds": 2729,
            "endSeconds": 2839,
            "summary": "Thanked María and Familia Unidas for helping her navigate the educational system in a new country and for instilling reading and healthy habits that benefited her son's schooling."
          }
        ],
        "consent": false,
        "pulled": false
