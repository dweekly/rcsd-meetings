        "itemLabel": "5",
        "title": "Recognition of María Díaz-Slocum",
        "phases": {
          "opened": 778,
          "presentation": 919,
          "publicComment": null,
          "discussion": null,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Dennis McBride",
            "startSeconds": 1862,
            "endSeconds": 2033,
            "summary": "Offered a warm tribute to María Díaz-Slocum, highlighting her 21 years of dedication, her calm leadership, her advocacy for students particularly on the Bay Side, and his personal fond memories of working alongside her."
          },
          {
            "name": "Ninfa / Secundino (Familias Unidas)",
            "startSeconds": 2067,
            "endSeconds": 2154,
            "summary": "On behalf of Familias Unidas parents and students, expressed gratitude to María for her years of unconditional support and contributions to hundreds of families through literacy and learning."
          },
          {
            "name": "Community speaker (former mayor)",
            "startSeconds": 2170,
            "endSeconds": 2264,
            "summary": "As a freshly retired city official, praised María as a giant in Redwood City whose equity work predated the broad discussion of equity, and congratulated Cecilia Márquez and welcomed David Weekly."
          },
          {
            "name": "Michelle Torres",
            "startSeconds": 2290,
            "endSeconds": 2404,
            "summary": "Thanked María for her support of Familias Unidas, shared how the program helped her integrate into the community and how her son's grades improved from failing to excellent thanks to strategies learned there."
          },
          {
            "name": "Beatriz Fernanda Senda",
            "startSeconds": 2569,
            "endSeconds": 2700,
            "summary": "An 11-year-old Familias Unidas participant since preschool, described her love of books and learning fostered by the program and expressed hope it would continue for future students including her younger brother."
          },
          {
            "name": "Laura Ramírez",
            "startSeconds": 2729,
            "endSeconds": 2841,
            "summary": "Thanked María for supporting Familias Unidas and described how the program helped her navigate the U.S. educational system and start her son's schooling with good reading and healthy daily habits."
          }
        ],
        "consent": false,
        "pulled": false
      },
