        "itemLabel": "13.1",
        "title": "Approval of Permanently Renaming the 170 Selby Lane Site as Adelante Selby Spanish Immersion School",
        "phases": {
          "opened": 5060,
          "presentation": 5088,
          "publicComment": 5480,
          "discussion": 6092,
          "vote": {
            "seconds": 6806,
            "type": "roll-call",
            "result": "5-0 (to reject the proposed name)"
          }
        },
        "publicComments": [
          {
            "name": "Michelle Smith",
            "startSeconds": 5507,
            "endSeconds": 5705,
            "summary": "Advocated that neither Adelante alone nor Adelante Selby was fully satisfying, and suggested 'Unidos' as a more unifying alternative name that her children and other parents supported as representing both communities coming together."
          },
          {
            "name": "Rita Melton",
            "startSeconds": 5729,
            "endSeconds": 5943,
            "summary": "Read a letter signed by Adelante teachers objecting to the name Adelante Selby, arguing Thomas H. Selby has no connection to bilingualism or immersion, that the Adelante program is internationally recognized and its name should be honored as the majority vote winner, and offering Unidos as a second-choice alternative."
          },
          {
            "name": "James Carrig",
            "startSeconds": 5982,
            "endSeconds": 6086,
            "summary": "Expressed disappointment that Adelante teachers and staff were still pushing for strictly the Adelante name rather than moving on, suggested a completely fresh new name for a true new beginning, questioned the equity of the voting process, and suggested that a board member who is a parent at the school might consider abstaining from the vote."
          }
        ],
