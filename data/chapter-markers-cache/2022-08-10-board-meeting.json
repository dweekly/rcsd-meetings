      {
        "itemLabel": "14.1",
        "title": "Adoption of Resolution 2, Ordering a School Bond Election on November 8, 2022 (moved earlier in agenda)",
        "phases": {
          "opened": 719,
          "presentation": 751,
          "publicComment": 1071,
          "discussion": 977,
          "vote": {
            "seconds": 2584,
            "type": "roll-call",
            "result": "5-0"
          }
        },
        "publicComments": [
          {
            "name": "Chris Robel",
            "startSeconds": 1329,
            "endSeconds": 1577,
            "summary": "Opposed the bond measure, arguing a parcel tax would be more equitable, that bond financing benefits investors at taxpayers' expense, and that declining enrollment and poor academic outcomes call into question whether facilities investment is the right priority."
          },
          {
            "name": "Katerina Schwaidenbeck",
            "startSeconds": 1613,
            "endSeconds": 1736,
            "summary": "Supported the bond, citing broken bathrooms and the lack of a central kitchen as facility problems that directly affect student health and learning."
          },
          {
            "name": "Jessica Shade",
            "startSeconds": 1764,
            "endSeconds": 1884,
            "summary": "Supported the bond, highlighting the need to meet health and safety standards, potential for a central kitchen, community benefits of improved schools, and the district's track record of completing Measure T on time and under budget."
          },
          {
            "name": "Jessica Meunier",
            "startSeconds": 1947,
            "endSeconds": 2053,
            "summary": "Supported the bond, expressing enthusiasm for the central kitchen component to improve meal quality and for updated safety standards, noting confidence based on the prior bond's on-time, under-budget delivery."
          },
          {
            "name": "Elmer Martinez",
            "startSeconds": 2071,
            "endSeconds": 2131,
            "summary": "Supported the bond as a community volunteer and former Roosevelt student, emphasizing the need for critical facility upgrades at aging schools to ensure safe, quality learning environments and strong community and property values."
          },
          {
            "name": "Ileana Harrison",
            "startSeconds": 2149,
            "endSeconds": 2288,
            "summary": "Supported the bond as a pediatrician and parent of incoming students at Orion Alternative School, praising the new building from Measure T, reporting broad parent support, and strongly endorsing the central kitchen component to enable cooking fresh, healthy meals for students."
          }
        ],
        "consent": false,
        "pulled": false
      },
