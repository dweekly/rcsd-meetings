          {
            "name": "Ana Solorio",
            "startSeconds": 152,
            "endSeconds": 278,
            "summary": "Speaking as classified members union president, urged the board to reconsider and increase the funding approved for classified staff contract negotiations, arguing that the current amount and proposed 1% raise do not reflect the value of nearly 400 classified employees."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 286,
            "endSeconds": 430,
            "summary": "As CSEA chief union steward, raised concerns about classified employees being improperly denied leaves of absence contrary to contract language, citing two specific cases, and asked the board to clarify who is responsible for approving such leaves."
          },
          {
            "name": "Mike Swire",
            "startSeconds": 494,
            "endSeconds": 663,
            "summary": "Renewed his request for the board to take action to remove Henry Ford's name from the district school, thanking Trustee Weekley for responding to his email but expressing disappointment that no other board members or the superintendent had responded."
          }
