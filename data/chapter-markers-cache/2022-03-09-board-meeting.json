        "publicComments": [
          {
            "name": "Eric (tech staff)",
            "startSeconds": 543,
            "endSeconds": 756,
            "summary": "Read a letter on behalf of the technology department describing how they were required to be physically present throughout the pandemic while other staff worked from home, and argued they deserved additional compensation comparable to the stipends teachers received for returning to work."
          },
          {
            "name": "Ryan Sue",
            "startSeconds": 798,
            "endSeconds": 996,
            "summary": "Followed up on the letter Eric read, explaining the tech team's central role during the pandemic and expressing frustration that the district's proposed MOU offered only five restricted holidays compared to the $58/day stipend teachers received."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 1023,
            "endSeconds": 1166,
            "summary": "A 43-year district employee described a decline in respect for classified staff under current administration, criticized inequitable treatment during the pandemic, and invited board members to visit campuses and speak directly with classified employees."
          },
          {
            "name": "Ana Solorio",
            "startSeconds": 1170,
            "endSeconds": 1309,
            "summary": "Presented signatures from classified members requesting board support in MOU negotiations, arguing that classified staff who were physically present during the pandemic deserve compensation, noting they are asking for far less than the teacher stipend."
          },
          {
            "name": "Johanna Rasmussen",
            "startSeconds": 1599,
            "endSeconds": 1689,
            "summary": "Described repeated assaults on her fourth-grade son at Roosevelt School, including an incident where he was forced to his knees by a group of children despite a signed safety plan, and asked the board to intervene on the escalating bullying issue."
          }
        ],
        "consent": false,
        "pulled": false
      },
