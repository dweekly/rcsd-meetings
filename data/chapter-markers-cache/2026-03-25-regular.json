        "publicComments": [
          {
            "name": "Kristy Herrera",
            "startSeconds": 468,
            "endSeconds": 650,
            "summary": "A 24-year kindergarten teacher at Hoover described her classroom as an ER-like environment due to high class sizes (28 students) and complex student needs, urging the board to prioritize smaller class sizes and consistent instructional support district-wide."
          },
          {
            "name": "Henry Tower",
            "startSeconds": 666,
            "endSeconds": 846,
            "summary": "A parent of an incoming TK student at Orion requested additional classroom space for the Play Thrive after-school program to support Mandarin immersion students, emphasizing the cultural and linguistic value of the program."
          },
          {
            "name": "Renee Lowe",
            "startSeconds": 858,
            "endSeconds": 947,
            "summary": "A parent of an incoming TK Mandarin immersion student at Orion asked the board to approve additional classrooms for Play Thrive, noting every new family has been waitlisted as the program cannot expand due to space constraints."
          },
          {
            "name": "Anjian Wu",
            "startSeconds": 952,
            "endSeconds": 1124,
            "summary": "A parent of an incoming TK student at Orion who was waitlisted for Play Thrive despite applying within the first two minutes asked the board to proactively expand on-campus after-school capacity to keep pace with the growing Mandarin immersion program."
          }
        ],
        "consent": false,
        "pulled": false
      },
