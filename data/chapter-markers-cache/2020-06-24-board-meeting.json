          {
            "name": "Megan O'Reilly Green",
            "startSeconds": 5048,
            "endSeconds": 5239,
            "summary": "As interim co-president of the Starship PTO, said the Mandarin immersion program is open to all students regardless of background, expressed frustration at recurring social-media accusations of inequitable funding, and noted that PTO dollars benefit the whole campus community."
          },
          {
            "name": "Amy Wang",
            "startSeconds": 5250,
            "endSeconds": 5371,
            "summary": "Said the Facebook post about budget inequity was based on only a few line items and did not reflect the full picture of funding sources, and urged community members to avoid divisive or inaccurate statements."
          },
          {
            "name": "Sue Jorgensen",
            "startSeconds": 5463,
            "endSeconds": 5718,
            "summary": "Identified herself as the author of the Facebook post, defended it as accurate and professional, argued that PTO-driven funding disparities between programs are a genuine equity issue, and shared concerns about unequal enrichment opportunities across schools including Northstar, Orion, and Taft."
          }
        ],
        "consent": false,
        "pulled": false
      },
