      {
        "itemLabel": "14.2",
        "title": "Approval of 2020-21 Proposed Budget for Redwood City School District",
        "phases": {
          "opened": 3831,
          "presentation": 3839,
          "publicComment": 4729,
          "discussion": 4613,
          "vote": {
            "seconds": 5736,
            "type": "roll-call",
            "result": "5-0"
          }
        },
        "publicComments": [
          {
            "name": "Katie Goetz",
            "startSeconds": 4771,
            "endSeconds": 4896,
            "summary": "Clarified that Mandarin immersion PTO funds shown in the budget pay for aides and a teacher coach who must be hired through the district, so the budget line does not capture all program spending, and asked the community not to draw inequity conclusions from a few line items."
          },
          {
            "name": "Sarah Rutherford",
            "startSeconds": 4909,
            "endSeconds": 5036,
            "summary": "As Orion Mandarin Immersion site council member, explained that PTO fundraising is deliberately structured to avoid relying on Title I funds for personnel, and emphasized that language immersion programs require expensive aides and coaching because most families are non-Mandarin speakers."
          },
          {
            "name": "Megan O'Reilly Green",
            "startSeconds": 5048,
            "endSeconds": 5239,
            "summary": "As interim co-president of the Starship PTO, said the Mandarin immersion program is open to all students regardless of background, expressed frustration at recurring social-media accusations of inequitable funding, and noted that PTO dollars benefit the whole campus community."
          },
          {
            "name": "Amy Wang",
            "startSeconds": 5250,
            "endSeconds": 5371,
            "summary": "Said the Facebook post about budget inequity was based on only a few line items and did not reflect the full picture of funding sources, and urged community members to avoid divisive or inaccurate statements."
          },
          {
            "name": "Sue Jorgensen",
            "startSeconds": 5463,
            "endSeconds": 5718,
            "summary": "Identified herself as the author of the Facebook post, defended it as accurate and professional, argued that PTO-driven funding disparities between programs are a genuine equity issue, and shared concerns about unequal enrichment opportunities across schools including Northstar, Orion, and Taft."
          }
        ],
        "consent": false,
        "pulled": false
      },
