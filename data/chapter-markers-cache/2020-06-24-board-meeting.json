        "itemLabel": "12",
        "title": "Discussion on COVID-19",
        "phases": {
          "opened": 1314,
          "presentation": 1326,
          "publicComment": 2461,
          "discussion": 1748,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Kathryn Stewart",
            "startSeconds": 2483,
            "endSeconds": 2576,
            "summary": "Asked about interactive instructional hours for Mandarin immersion online learning, requested a diagram showing how 12 students would be arranged in a classroom with 6-foot distancing, and asked when the district would confirm if returning without a vaccine so parents could declare distance-learning-only preferences."
          },
          {
            "name": "Linda Elkins",
            "startSeconds": 2823,
            "endSeconds": 2893,
            "summary": "Noted that Contra Costa County guidance requires only 4 feet between students (not 6) and that masks for ages 3–11 are strongly encouraged but not required, and asked whether the district could advocate for similar less-restrictive rules in San Mateo County."
          },
          {
            "name": "Maria Stockton",
            "startSeconds": 3486,
            "endSeconds": 3645,
            "summary": "Representing CSEA, thanked Wendy Kelly for a productive meeting, urged the district not to lay off classified staff during COVID since laid-off workers are unlikely to return, and offered creative ideas for redeploying classified employees in hybrid and online roles."
          }
        ],
        "consent": false,
        "pulled": false
      },
