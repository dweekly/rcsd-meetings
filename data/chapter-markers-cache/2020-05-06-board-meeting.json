        "publicComments": [
          {
            "name": "Suzanne Ruiz Dunlap",
            "startSeconds": 359,
            "endSeconds": 482,
            "summary": "Urged the board to allow the naming committee to consider 'Adelante Selby' as a choice for the Spanish immersion school name, arguing the decision to remove it was made too quickly and without sufficient community input."
          },
          {
            "name": "Michelle Smith",
            "startSeconds": 547,
            "endSeconds": 745,
            "summary": "Argued the board's naming policy is undemocratic, called for either amending the policy to include a more democratic process or allowing the community's vote to stand, and criticized the board's handling of the naming process."
          },
          {
            "name": "Nicole Russo",
            "startSeconds": 815,
            "endSeconds": 929,
            "summary": "Expressed support for moving forward with a new name rather than retaining 'Adelante Selby,' emphasizing the need to settle the issue and focus on the community going forward."
          },
          {
            "name": "Lance Powell",
            "startSeconds": 957,
            "endSeconds": 1100,
            "summary": "Argued that the community had already voted overwhelmingly to keep the name 'Adelante Selby,' that the legacy of both schools should be honored, and urged the board to respect the democratic process."
          },
          {
            "name": "Rex Northern",
            "startSeconds": 1137,
            "endSeconds": 1306,
            "summary": "Expressed concern that rejecting the community's vote on the school name undermines confidence in the board and extends unnecessary pain during the pandemic, urging the board to honor the democratic process."
          },
          {
            "name": "Steven Zoepf",
            "startSeconds": 1325,
            "endSeconds": 1329,
            "summary": "Echoed the comments of Lance Powell and Rex Northern and ceded the remainder of his time."
          },
          {
            "name": "Catherine Stewart",
            "startSeconds": 1359,
            "endSeconds": 1570,
            "summary": "Requested permission to begin purchasing supplies such as desks, fogger cleaning machines, and infrared temperature scanners to prepare for the fall school reopening, offering specific cost estimates and urging the district to act now before items sell out."
          }
        ],
        "consent": false,
        "pulled": false
      },
