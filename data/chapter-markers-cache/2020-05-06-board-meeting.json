        "publicComments": [
          {
            "name": "Suzanne Ruiz Dunlap",
            "startSeconds": 359,
            "endSeconds": 482,
            "summary": "Urged the board to allow the naming committee to consider 'Adelante Selby Spanish Immersion School' as an option, arguing the decision to remove it was made quickly and without sufficient community input."
          },
          {
            "name": "Michelle Smith",
            "startSeconds": 547,
            "endSeconds": 745,
            "summary": "Called the naming policy undemocratic, argued the process had caused community anguish, and urged the board to either amend the policy to include a more democratic process or stop wasting the naming committee's time."
          },
          {
            "name": "Nicole Russo",
            "startSeconds": 815,
            "endSeconds": 929,
            "summary": "Expressed appreciation that the board heard parents' voices and encouraged moving forward with a new name that reflects the new community rather than holding onto the past."
          },
          {
            "name": "Lance Powell",
            "startSeconds": 957,
            "endSeconds": 1100,
            "summary": "As a career educator and parent of two Adelante Selby students, argued that the community's majority vote to keep the 'Adelante Selby' name should be honored and that ignoring it undermines trust and the school's legacy."
          },
          {
            "name": "Rex Northern",
            "startSeconds": 1137,
            "endSeconds": 1306,
            "summary": "Argued that starting a quasi-democratic process and then ignoring the community's vote erodes confidence, and that extending the naming issue unnecessarily prolongs community pain at a time when education should be the priority."
          },
          {
            "name": "Steven Zoepf",
            "startSeconds": 1325,
            "endSeconds": 1329,
            "summary": "Echoed the comments of Lance Powell and Rex Northern and ceded the remainder of his time."
          },
          {
            "name": "Catherine Stewart",
            "startSeconds": 1359,
            "endSeconds": 1570,
            "summary": "Urged the district to begin purchasing supplies now (including IKEA desks, fogging cleaners, and infrared temperature scanners) to prepare for reopening in the fall before items sell out."
          }
        ],
        "consent": false,
        "pulled": false
      },
