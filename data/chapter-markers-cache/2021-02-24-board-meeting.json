      {
        "itemLabel": "12.1",
        "title": "Discussion on COVID-19",
        "phases": {
          "opened": 1089,
          "presentation": 1117,
          "publicComment": 5468,
          "discussion": 4564,
          "vote": null
        },
        "publicComments": [
          {
            "name": "Cameron Hoffman",
            "startSeconds": 5492,
            "endSeconds": 5672,
            "summary": "Praised board members who spoke in favor of reopening, urged the administration to adopt a more decisive and urgent tone, and noted that by the county's own definition only Taft School has formally reopened, calling on the district to commit to reopening all schools by the return from spring break."
          },
          {
            "name": "Allison Oford",
            "startSeconds": 5715,
            "endSeconds": 5884,
            "summary": "Requested the district publish a regular reopening dashboard for transparency, thanked staff working in person, and argued that returning students to campus this school year is worthwhile for mental health, screen-time reduction, and preparing for a stronger fall return."
          },
          {
            "name": "Mary Beth Maloney",
            "startSeconds": 5955,
            "endSeconds": 6060,
            "summary": "Welcomed the board's progress toward reopening but stressed the need for a concrete plan for middle school students to return to campus, urging the district to think creatively and not leave tweens and teens behind."
          },
          {
            "name": "Mercedes Kwiajkowski",
            "startSeconds": 6136,
            "endSeconds": 6320,
            "summary": "As a child and adolescent psychiatrist, described worsening mental health impacts of distance learning on children and implored the board to reopen schools immediately, citing national expert guidance, low county transmission rates, and firsthand evidence of rapid student improvement upon returning to campus."
          },
          {
            "name": "Katherine Stewart",
            "startSeconds": 6334,
            "endSeconds": 6450,
            "summary": "Stated she would not send her child back to school until a COVID vaccine is available for children and argued that distance learning options, including Mandarin immersion, should continue for families who are not ready to return."
          },
          {
            "name": "Heidi",
            "startSeconds": 6558,
            "endSeconds": 6700,
            "summary": "Expressed that the board's prior lack of guidance has created mistrust between teachers and parents, called on the board to be more proactive and decisive, highlighted concerns about children being left behind in distance learning, and applauded the forward progress made at this meeting."
          }
        ],
        "consent": false,
        "pulled": false
      },
